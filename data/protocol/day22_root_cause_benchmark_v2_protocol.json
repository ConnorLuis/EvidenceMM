  "interventions": {
    "target_offset_or_perception": {
      "intervention_type": "object_target_pose_offset",
      "primary_changed_factor": "environment_target_pose",
      "operator_rule": "Keep the nominal teleoperation intent unchanged while changing the object's target-relative pose within the existing safe workspace.",
      "pilot_parameters": {
        "direction_field": "target_offset_direction",
        "magnitude_field": "target_offset_magnitude",
        "unit_field": "target_offset_unit",
        "numeric_values_frozen_on_day22": false
