    },
    "gripper_close_timing": {
      "intervention_type": "manual_gripper_close_timing_shift",
      "primary_changed_factor": "gripper_close_phase",
      "operator_rule": "Use the existing Leader teleoperation path and intentionally close the gripper earlier or later than the nominal grasp phase without adding a second primary deviation.",
      "pilot_parameters": {
        "direction_field": "timing_direction",
        "magnitude_field": "timing_shift",
        "unit_field": "timing_shift_unit",
        "numeric_values_frozen_on_day22": false
      }
    },
    "trajectory_execution_deviation": {
      "intervention_type": "manual_bounded_trajectory_deviation",
      "primary_changed_factor": "commanded_motion_path",
      "operator_rule": "Keep the object condition nominal and introduce one bounded, predeclared path deviation through Leader teleoperation inside the existing safe workspace.",
      "pilot_parameters": {
        "direction_field": "deviation_direction",
        "magnitude_field": "deviation_magnitude",
        "unit_field": "deviation_unit",
        "numeric_values_frozen_on_day22": false
      }
    }
  },
