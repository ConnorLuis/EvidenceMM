{
  "schema_version": "evidencemm_day31_root_cause_baseline_config_v1",
  "status": "pre_baseline_frozen_config",
  "baseline_mode": "direct_zero_shot_multimodal_no_retrieval",
  "model": {
    "model_name": "Qwen/Qwen3-VL-4B-Instruct",
    "image_patch_size": 16,
    "max_new_tokens": 256,
    "min_pixels": 50176,
    "max_pixels": 786432,
    "attn_implementation": "sdpa",
    "do_sample": false
  },
  "population": {
    "split": "development",
    "expected_episode_count": 60,
    "held_out_inference_allowed": false,
    "held_out_ground_truth_use_allowed": false
  },
  "evidence_selection": {
    "frame_count": 900,
    "uniform_anchor_count": 7,
    "dynamic_frame_count": 5,
    "dynamic_score": "max(adjacent_observation_rms,adjacent_action_rms)",
    "dynamic_min_separation_frames": 20,
    "total_selected_frame_count": 12,
    "camera_transforms": {
      "front": "none",
      "wrist": "ccw90"
    }
  },
  "contact_sheets": {
    "frames_per_sheet": 4,
    "sheet_count": 3,
    "sheet_width": 768,
    "row_height": 220,
    "jpeg_quality": 90
  },
  "diagnostic_taxonomy": [
    "target_offset_or_perception",
    "gripper_close_timing",
    "trajectory_execution_deviation",
    "insufficient_evidence",
    "clean_success"
  ],
  "output_contract": {
    "strict_json": true,
    "parse_failure_decision": "insufficient_evidence",
    "parse_failure_confidence": 0.0,
    "evidence_frames_must_be_supplied_frames": true
  },
  "boundaries": {
    "retrieval_used": false,
    "manual_corpus_used": false,
    "training_performed": false,
    "calibration_performed": false,
    "prompt_tuning_after_results": false,
    "model_selection_using_development_results": false,
    "held_out_prompt_tuning": false,
    "held_out_retrieval_tuning": false,
    "held_out_model_selection": false
  }
}
